/*
 * <%= label %> theme for @dmaster/ui — generated by `ng generate @dmaster/ui:theme`.
 *
 * Overriding --dm-primary re-derives hover, tinted text, the subtle fill, the
 * brand gradient and the focus ring automatically (OKLCH cascade) — so a custom
 * theme is usually just a color or two. Load AFTER the @dmaster/ui base styles;
 * ng generate already wired this file into angular.json.
 */
<% if (named) { %>/*
 * Switchable named theme. Register it so ThemeService.setTheme('<%= name %>')
 * works and it appears in a picker:
 *
 *   provideDmasterUI({
 *     themes: { '<%= name %>': { scheme: '<%= scheme %>', label: '<%= label %>' } },
 *   })
 */
[data-dm-theme='<%= name %>'] {
  color-scheme: <%= scheme %>;

  --dm-primary: <%= primary %>;
  /* --dm-primary-fg: #fff;  // label over a solid primary — set a dark value if your primary is light */

  /* Uncomment to reshape surfaces, text and borders for this theme:
  --dm-bg: #0b1020;
  --dm-bg-subtle: #111630;
  --dm-bg-muted: #1a1f40;
  --dm-bg-elevated: #222850;
  --dm-fg: #e7ecff;
  --dm-fg-muted: #aab4dd;
  --dm-border: rgb(124 156 255 / 15%);
  */

  /* Per-component knobs — override any of the ~300 --dm-<component>-* tokens:
  --dm-button-radius: var(--dm-radius-md);
  --dm-card-shadow: var(--dm-shadow-lg);
  */
}
<% } else { %>/*
 * Global recolor: applies in light AND dark, so the built-in light/dark toggle
 * keeps working. Tune the dark value below if the brand color needs more punch.
 */
:root {
  --dm-primary: <%= primary %>;
  /* --dm-primary-fg: #fff;  // label over a solid primary — set a dark value if your primary is light */

  /* Uncomment to also reshape the design language:
  --dm-radius-md: 0.5rem;
  --dm-button-radius: var(--dm-radius-md);
  */
}

[data-dm-theme='dark'] {
  --dm-primary: <%= primary %>;
}
<% } %>