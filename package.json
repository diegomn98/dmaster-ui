{
  "name": "@dmaster/ui",
  "version": "0.3.0",
  "description": "Modern, premium Angular UI components. Standalone, signals-based, themeable via CSS variables.",
  "license": "MIT",
  "author": {
    "name": "Diego Maestro",
    "email": "diegomaestro192@gmail.com",
    "url": "https://github.com/diegomn98"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegomn98/dmaster-ui-workspace.git",
    "directory": "projects/ngx-dmaster-ui"
  },
  "homepage": "https://dmasterui.com",
  "bugs": {
    "url": "https://github.com/diegomn98/dmaster-ui-workspace/issues"
  },
  "keywords": [
    "angular",
    "components",
    "ui",
    "standalone",
    "signals",
    "zoneless",
    "dark-mode",
    "design-system",
    "heroui",
    "css-variables",
    "cdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "exports": {
    "./styles": {
      "sass": "./styles/index.scss",
      "style": "./styles/dmaster-ui.css",
      "default": "./styles/dmaster-ui.css"
    },
    "./styles/index": {
      "sass": "./styles/index.scss",
      "default": "./styles/index.scss"
    },
    "./styles/dmaster-ui.css": {
      "style": "./styles/dmaster-ui.css",
      "default": "./styles/dmaster-ui.css"
    },
    "./styles/*": {
      "sass": "./styles/*",
      "style": "./styles/*",
      "default": "./styles/*"
    }
  },
  "sideEffects": false
}
